# Leave empty to run on built-in mock data.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Storefront URL for the "View store" link.
NEXT_PUBLIC_STORE_URL=http://localhost:3000
# Optional: public URL of this admin app for password-reset links (defaults to the request's origin).
ADMIN_URL=
