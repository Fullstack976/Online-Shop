{
  "name": "online-shop",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "node scripts/dev.mjs --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:seed-sql": "node packages/db/scripts/generate-seed.ts > supabase/seed.sql",
    "db:seed": "node --env-file=.env packages/db/scripts/seed-supabase.ts"
  },
  "devDependencies": {
    "turbo": "^2.11.6"
  },
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
